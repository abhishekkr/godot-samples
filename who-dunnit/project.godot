run/main_scene="uid://bomvngsnlbtrf"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/image="uid://mgufugn5wfbo"
config/icon="uid://brrlur0dc3qqh"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"alice": "res://characters/alice.dch",
"brie": "res://characters/brie.dch",
"charles": "res://characters/charles.dch"
}
directories/dtl_directory={
"enquire_alice": "res://timelines/enquire_alice.dtl",
"enquire_brie": "res://timelines/enquire_brie.dtl",
"finale": "res://timelines/finale.dtl",
"timeline_i": "res://timelines/timeline_i.dtl"
}
layout/style_directory={
"": "res://dialogic_style/vn_style.tres",
"vn_style": "res://dialogic_style/vn_style.tres"
}
layout/style_list=["res://dialogic_style/vn_style.tres"]
layout/default_style="res://dialogic_style/vn_style.tres"
text/letter_speed=0.025
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.2
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
text/autocolor_names=true
text/autoskip_time_per_event=1.15
text/autoadvance_fixed_delay=2.5
text/split_at_new_lines=false
text/split_at_new_lines_as=0
text/input_action="dialogic_default_action"
variables={
"Audio": true,
"Brie": 0
}
glossary/default_case_sensitive=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

